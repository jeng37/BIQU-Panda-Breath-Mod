# ============================================================
# BIQU Panda Breath Mod – Konfiguration
# ------------------------------------------------------------
# Kopiere diese Datei nach config.env und trage deine Werte ein:
#   cp config.env.example config.env
#
# Diese Werte überschreiben (falls vorhanden) panda_config.json.
# ============================================================

# --- Pflichtfelder (Container startet sonst nicht) ---
MQTT_BROKER=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
PANDA_IP=
PANDA_SN=
PANDA_ACCESS_CODE=

# --- Home Assistant ---
HA_TOKEN=
# Vollständige URL zum Bett-Temperatur-Sensor, z.B.
# http://homeassistant.local:8123/api/states/sensor.ks1c_bed_temperature
HA_SENSOR_URL=

# --- TLS-Zertifikate (Standard für Docker, nicht ändern, wenn ./certs gemountet wird) ---
CERT_PATH=/certs/cert.pem
KEY_PATH=/certs/key.pem

# --- Weitere benötigte Werte ---
# HOST_IP: IP-Adresse des Hosts, auf dem der Container läuft. Diese IP muss in der
# Panda-UI als "Printer IP" eingetragen werden.
HOST_IP=
# MQTT-Topic-Präfix (muss panda_breath_mod sein, damit HA-Entities passen).
MQTT_TOPIC_PREFIX=panda_breath_mod
# PRINTER_IP: IP des Druckers/Moonraker-Hosts (für Slicer-Gcode-Analyse).
PRINTER_IP=

# --- Optional / Defaults ---
# DEBUG=false
# DEBUG_TO_FILE=true
# HYSTERESE=1.5
# MIN_SWITCH_TIME=10
# Alternativ zu HA_SENSOR_URL: HA_BASE_URL + HA_BED_TEMPERATURE_ENTITY
# HA_BASE_URL=http://homeassistant.local:8123
# HA_BED_TEMPERATURE_ENTITY=sensor.ks1c_bed_temperature
